{
  "name": "Autonomous Paper Trader Daily Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 16 * * 1-5"
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule (Daily 4:30 PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "cd D:/Code/trading-agent && python run_daily.py"
      },
      "id": "2",
      "name": "Run Daily Trading Cycle",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "filePath": "D:/Code/trading-agent/logs/us_portfolio.json"
      },
      "id": "3",
      "name": "Read US Portfolio State",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "filePath": "D:/Code/trading-agent/logs/india_portfolio.json"
      },
      "id": "4",
      "name": "Read India Portfolio State",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [680, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:20128/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"ag/gemini-3.8-flash\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Summarize daily paper trading performance and assess energy/tech market regimes based on current portfolio states.\"\n    }\n  ]\n}"
      },
      "id": "5",
      "name": "Gemini 3.8 Daily Reflection (via 9router)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300]
    }
  ],
  "connections": {
    "Schedule (Daily 4:30 PM)": {
      "main": [
        [
          {
            "node": "Run Daily Trading Cycle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Daily Trading Cycle": {
      "main": [
        [
          {
            "node": "Read US Portfolio State",
            "type": "main",
            "index": 0
          },
          {
            "node": "Read India Portfolio State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read US Portfolio State": {
      "main": [
        [
          {
            "node": "Gemini 3.8 Daily Reflection (via 9router)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
