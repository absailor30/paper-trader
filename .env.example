# Postgres in production. Omit entirely for local dev — defaults to a
# local SQLite file (paper_trader.db) via the same code path.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Capital
US_CAPITAL=100
INDIA_CAPITAL=10000

# Risk parameters
MAX_POSITION_SIZE=0.12
MAX_DAILY_LOSS=0.04
MAX_DRAWDOWN=0.15

# Autonomy gate. Leave false until paper_trader/backtest/run_backtest.py
# has shown positive expectancy for the strategy against real data.
AUTO_EXECUTE=false
