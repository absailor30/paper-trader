# Alpaca (US Stocks)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Gemini (Google AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Risk Parameters
MAX_POSITION_SIZE=0.12
MAX_DAILY_LOSS=0.04
STOP_LOSS=0.06
MAX_DRAWDOWN=0.15

# Capital
US_CAPITAL=100
INDIA_CAPITAL=10000

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Postgres (portfolio state persistence). Leave unset to use local JSON
# files under logs/ instead. Required on Render free plan to survive
# redeploys/restarts, which wipe local disk. Get a free instance from
# neon.tech or supabase.com.
DATABASE_URL=postgresql://user:password@host:5432/dbname
